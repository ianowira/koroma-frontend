# Strapi backend URL
NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337

# Strapi API URL (for server-side requests)
STRAPI_API_URL=http://localhost:1337

# Strapi API token (Strapi admin: Settings > API Tokens > Create new token, read-only)
# Server-side only: do NOT prefix with NEXT_PUBLIC_
STRAPI_API_TOKEN=
